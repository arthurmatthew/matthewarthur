---
import "@fontsource-variable/inter-tight";
import "../styles/global.css";
---

<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <title>Matthew Arthur - Web Developer</title>
    <meta
      name="description"
      content="Matthew Arthur is a web developer and musician from Seattle."
    />
  </head>
  <body>
    <div class="px-6"><slot /></div>
  </body>
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Matthew Arthur",
      "url": "https://matthewarthur.dev",
      "jobTitle": "Web Developer",
      "sameAs": [
        "https://www.linkedin.com/in/matthew-arthur-6889ba395/",
        "https://github.com/arthurmatthew"
      ]
    }
  </script>
</html>
